  "listing_query": "SELECT o.key, o.blob_id, b.blob_id AS stored_blob_id,\n       b.state AS blob_state, b.byte_length, b.etag, o.last_modified_at_ms,\n       b.md5_digest, b.part_count, b.shard\nFROM objects AS o\nLEFT JOIN blobs AS b ON b.blob_id = o.blob_id\nWHERE o.bucket_id = :bucket_id\n  AND o.key >= :prefix_lower\n  AND o.key < :prefix_upper\n  AND o.key > :after_key\nORDER BY o.key\nLIMIT :page_limit;"
}
