from typing import Self, final

__all__ = ["DiagnosticProbe", "Event"]

@final
class DiagnosticProbe:
    def __new__(cls) -> Self: ...
    def emit(self, detail: str) -> None: ...
    def take(self) -> Event | None: ...
    def observer_failed(self) -> None: ...
    def close(self) -> None: ...
    @property
    def stats(self) -> tuple[int, int, int, int]: ...

@final
class Event:
    @property
    def store_id(self) -> str: ...
    @property
    def work(self) -> str: ...
    @property
    def failure(self) -> str | None: ...
    @property
    def occurrences(self) -> int: ...
    @property
    def age_ms(self) -> int: ...
