from typing import Self, final

__all__ = ["ProbeError", "Reservation", "StreamProbe"]

class ProbeError(Exception):
    code: str

@final
class Reservation:
    def write(self, bytes: bytes) -> None: ...

@final
class StreamProbe:
    def __new__(cls, expected: int | None = None) -> Self: ...
    def reserve(self) -> Reservation: ...
    def read_chunk(self, max_bytes: int) -> bytes | None: ...
    def read_all(self, max_bytes: int) -> bytes: ...
    def end(self) -> None: ...
    def fail_producer(self) -> None: ...
    def close(self) -> None: ...
    @property
    def allocations(self) -> tuple[int, int]: ...
    @property
    def is_reading(self) -> bool: ...
